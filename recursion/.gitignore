enum status { odd = 0, evenN = 1, evenY = 2 };

string handleOdd(int num) {}

string handleEvenPower2(int num) {}

string handleEvenNotPower2(int num) {
    
}

status whichIs(int num) {
    if (num & 1 == 0)
    {
        if (!(log(num) - int(log(num))))
            return evenY;
        else
            return evenN;
    }
    return odd;
}

string decide(int num) {
    status numStat = whichIs(num);

    switch (numStat)
    {
    case evenY:
        return handleEvenPower2(num);
    case evenN:
        return handleEvenNotPower2(num);
    case odd:
        return handleOdd(num);
    default:
        break;
    }
}

